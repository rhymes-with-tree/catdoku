// Cloudflare Workers serves the site from the files tools/build-site.sh puts in _site (no Worker code, just the
// files). Cloudflare runs the build and `npx wrangler deploy` on every push to main. lapcatpuzzles.com and
// www.lapcatpuzzles.com are attached in the dashboard (Settings, Domains & Routes).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lapcatpuzzles",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
